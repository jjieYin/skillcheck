{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["groups"],
  "properties": {
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["group_id", "decision", "confidence", "reason"],
        "properties": {
          "group_id": {"type": "string", "minLength": 1},
          "decision": {
            "type": "string",
            "enum": ["KEEP_BOTH", "MERGE", "DEPRECATE", "DELETE_DUPLICATE", "RENAME", "REWRITE_BOUNDARY", "MANUAL_REVIEW"]
          },
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "reason": {"type": "string", "minLength": 1},
          "canonical_skill": {"type": ["string", "null"]},
          "recommendations": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
